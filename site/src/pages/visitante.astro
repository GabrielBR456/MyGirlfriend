---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---

<!-- Conteúdo público: definido na Etapa 10. Nada sensível aqui. -->
<Layout titulo="Visitante">
  <main class="min-h-dvh flex flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="text-2xl sm:text-4xl font-bold text-lilas">Olá, visitante!</h1>
    <p class="text-gelo/80">Em breve.</p>
    <a href={url()} class="text-dourado underline">Voltar</a>
  </main>
</Layout>
