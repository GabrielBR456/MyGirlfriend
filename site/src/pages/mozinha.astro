---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---

<!-- Casca pública: o login (Etapa 3) libera o conteúdo vindo do Supabase. Nada sensível aqui. -->
<Layout titulo="Mozinha">
  <main class="min-h-dvh flex flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="text-2xl sm:text-4xl font-bold text-lilas">Oi, mozinha</h1>
    <p class="text-gelo/80">O login chega em breve.</p>
    <a href={url()} class="text-dourado underline">Voltar</a>
  </main>
</Layout>
