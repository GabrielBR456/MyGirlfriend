---
import Layout from '../layouts/Layout.astro';
import { TITULO_SITE } from '../lib/site';
import { url } from '../lib/url';
---

<Layout>
  <main class="min-h-dvh flex flex-col items-center justify-center gap-10 px-6 text-center">
    <h1 class="text-3xl sm:text-5xl font-bold text-lilas">{TITULO_SITE}</h1>
    <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md">
      <a
        href={url('visitante')}
        class="flex-1 rounded-full border border-lilas px-6 py-3 font-semibold text-lilas hover:bg-anil transition"
      >
        Entrar como visitante
      </a>
      <a
        href={url('mozinha')}
        class="flex-1 rounded-full bg-coral px-6 py-3 font-semibold text-noite hover:bg-dourado transition"
      >
        Entrar como mozinha
      </a>
    </div>
  </main>
</Layout>
